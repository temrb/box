# Pinned OpenCode release used by build commands and launchers.
# Update all six values together via the documented upgrade procedure.
# Integrity pins are npm registry `dist.integrity` values (sha512) for the
# `opencode-ai` wrapper plus the Linux platform binaries it installs.
# NODE_VERSION is the exact NodeSource nodejs package pin; NODESOURCE_FINGERPRINT
# is the fail-closed APT key fingerprint assert (see Dockerfile --target opencode).
OPENCODE_VERSION=1.18.29
OPENCODE_NPM_INTEGRITY=sha512-syIDVwlrYTgTOXzZe9SkInJWethbq6l3SNC762UeXyO0a9V0wGfd+U4yACvppwNBnhIsl0j2QPYYCyLpNaSomg==
OPENCODE_NPM_INTEGRITY_LINUX_X64=sha512-X8/wS/8mzL7Ko0zYYF6RzKax39KkxXDRoimhmzXuo0gPrZX4DQjqBNpPAByBwUjFapk73ZGSVsjDGvoNapBa1Q==
OPENCODE_NPM_INTEGRITY_LINUX_ARM64=sha512-Lr7XXik5wPJZBV5RW+aR6Uogf1n5GogpB565m+D/jiO/vRXr9LhvCpixgAr1tiwuH1ZfMsqOOlbFQz5jgH3Tqg==
NODE_VERSION=22.23.2-1nodesource1
NODESOURCE_FINGERPRINT=6F71F525282841EEDAF851B42F59B5F99B1BE0B4
