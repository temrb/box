# Secrets — never commit live credentials.
meta-api-key
/opencode.json
providers.env
*.providers.env

# Local Codex CLI state — auth.json holds access tokens, never commit it.
.codex/
**/auth.json

# Runtime logs (test scratch logs are already covered by .bats-scratch/).
*.log

# Seed-refresh backups (setup keeps one .bak next to installed templates).
*.bak
*~
*.orig
*.rej
*.swp
*.swo

# Local test scratch (bats HOME override used by validation runs).
.bats*

/.agents/

/specs/

# Python bytecode / caches (native-probe.py, archive.py, tests/native/*.py).
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml

# Generated run evidence — keep curated *.md (linked from acceptance.md),
# ignore machine-generated logs/hashes/dumps with host paths and timestamps.
/box/docs/evidence/**/*.txt
/box/docs/evidence/**/*.jsonl
/box/docs/evidence/**/*.sha256
/box/docs/evidence/**/*.diff
/box/docs/evidence/security-resource-audit/next-pass/

# OS junk.
.DS_Store
Thumbs.db